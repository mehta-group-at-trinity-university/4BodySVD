           SubscriptBox["x", "2"]}], ")"}]}]},
       {"\[Placeholder]"}
      }], ")"}], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{"R", " ", "sin", " ", 
          SubscriptBox["\[Theta]", "13"], "cos", " ", 
          SubscriptBox["\[Phi]", "13"]}]},
